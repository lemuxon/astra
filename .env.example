# =========================================================
# ASTRA v12.0 — .env.example
# Bu dosyayı .env olarak kopyala ve gerçek değerleri gir:
#   cp .env.example .env
# .env dosyasını asla git'e ekleme!
# =========================================================

# Telegram
BOT_TOKEN=
CHAT_ID=

# Binance Spot API
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

# Binance Futures API — İŞLEM/EMİR yönü
# ⚠️ Bu satır SİLİNİRSE veya boş bırakılırsa varsayılan TESTNET'tir (K-106).
#    Gerçek parayla işlem için AÇIKÇA yazmak gerekir:
#       FUTURES_BASE_URL=https://fapi.binance.com
#    Piyasa verisi bundan etkilenmez; klines/ticker her zaman gerçek
#    borsadan okunur (BINANCE_DATA_URL).
FUTURES_BASE_URL=https://testnet.binancefuture.com

# Kaldıraç (1-125 arası, dikkatli kullan!)
FUTURES_LEVERAGE=5
FUTURES_MARGIN_TYPE=ISOLATED

# SL/TP çarpanları (ATR bazlı)
FUTURES_SL_ATR_MULT=1.5
FUTURES_TP_ATR_MULT=2.0
FUTURES_TP2_ATR_MULT=3.5

# Kademeli TP: TP1 fiyatında %50 pozisyon kapat
FUTURES_PARTIAL_TP=true
FUTURES_PARTIAL_TP_PCT=50

# Trailing Stop (kalan pozisyon için)
FUTURES_TRAILING_STOP=false
FUTURES_TRAILING_CALLBACK=1.5

# Genel
SCAN_INTERVAL=60
BALANCE=10000
RISK_PERCENT=0.02
COINS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT

# Sinyal filtreleri
MIN_AI_SCORE_BUY=6
MIN_AI_SCORE_SELL=-6
MIN_CONFIDENCE=60

# Gerçek işlem (true = canlı, false = paper trading)
# ⚠️ v55: Varsayılan olarak KAPALI geliyor. Gerçek para ile işlem yapmadan
# önce CANLI_GECIS_PROTOKOLU.md'yi oku ve bunu bilinçli olarak true yap.
# (Eskiden bu şablon true geliyordu; anahtarlarını doldurup bu satırı
#  gözden kaçıran biri farkında olmadan canlı işleme başlıyordu.)
LIVE_TRADING=false
TRADE_USDT=20

# Diğer
SHORT_ENABLED=true
MODEL_RETRAIN_INTERVAL=3600
DB_PATH=data/astra.db

WATCHDOG_MAX_SILENT=600
WATCHDOG_INTERVAL=60

# ── v13 Ayarları ──────────────────────────────────────────
TG_MIN_ARALIK_SINYAL=300
TG_MIN_ARALIK_REJIM=120
TG_MIN_ARALIK_SISTEM=300
EDGE_SCORE_MIN=35.0
MAX_FEEDBACK_KAYIT=1000
# (v55: WATCHDOG_* burada ikinci kez tanımlıydı — yukarıdakiyle çakışıyordu,
#  kafa karışıklığını önlemek için kaldırıldı.)

# ── v14 Kill Switch ───────────────────────────────────────
MAX_CONSECUTIVE_LOSS=5
MAX_DRAWDOWN_PCT_KILL=15.0
MAX_API_ERRORS_KILL=10
MAX_WS_DISCONNECTS=5

# ── v14 Trade Filtering ───────────────────────────────────
CHOP_FILTER_ENABLED=true
CHOP_MAX=61.8
MIN_VOLATILITY_PCT=0.3
MAX_VOLATILITY_PCT=5.0
FAKE_BREAKOUT_FILTER=true

# ── v14 Adaptive Sizing ───────────────────────────────────
ADAPTIVE_SIZING=true
MAX_POSITION_USDT=100.0

# ── v14 Backtest ──────────────────────────────────────────
BACKTEST_KOMISYON=0.0004
BACKTEST_SLIPPAGE_BPS=3.0
BACKTEST_KALDIRAC=5

# ── v14 Order Reconciler ──────────────────────────────────
RECONCILER_INTERVAL=15

# ── v15 Eksik Değerler ──────────────────────────────
# Testnet için boş bırak (config.py FUTURES_BASE_URL kullanır)
# BACKUP_FUTURES_URL=https://testnet.binancefuture.com

# ── v16 Circuit Breaker ───────────────────────────────────
MAX_ATR_PCT=4.0
MAX_FUNDING_RATE=0.003
MAX_SPREAD_PCT=0.15
CIRCUIT_BREAKER_BEKLEME=300

# ── v16 Correlation ───────────────────────────────────────
MAX_MAJORS_SAME_DIR=1
MAX_ALTS_SAME_DIR=2
MAX_TOPLAM_SAME_DIR=3

# ── v16 Shadow Model ──────────────────────────────────────
SHADOW_AUTO_APPROVE=true
SHADOW_MIN_IMPROVEMENT=0.5

# ── v27: Agresiflik / Pozisyon Boyutu ──
# Dampening katmanlarının pozisyonu en fazla ne kadar küçülteceği (0.45 = en fazla %55 kırpma)
POZ_MIN_DAMP_TABANI=0.45
# Genel agresiflik: 1.0=normal, 1.3=daha büyük pozisyon, 0.7=daha temkinli
POZ_AGRESIFLIK=1.0

# ── v28: Giriş Gecikme + Sağlamlaştırma ──
MAX_GIRIS_KAYMA_PCT=0.35
HIZLI_TARAMA=true
STATE_RECOVERY=true

# ── v34: VDS 7/24 sağlamlık ──
COIN_TUR_TIMEOUT=150
WS_STALE_ESIK_S=30

# ── Panel Güvenliği (v50) ──
# İkisini de doldurursanız web paneli kullanıcı adı/şifre ister.
# ⚠️ v55: Boş bırakılırsa panel KORUMASIZ açılır ve bot başlangıçta
# CRITICAL seviyede uyarı loglar. Panel bakiye, açık pozisyon, PnL ve
# strateji durumunu gösterir — internete açık bırakmayın.
# İkisinden yalnızca biri doldurulursa bot başlamayı REDDEDER.
PANEL_USER=
PANEL_PASS=
# Panel yalnızca localhost'a mı bağlansın? (önerilen: true)
# false yaparsanız 0.0.0.0'a bağlanır — yalnızca firewall/reverse-proxy varsa.
PANEL_SADECE_LOCALHOST=true
# CORS: boş bırakın (en güvenli). Sadece özel bir arayüzden erişim
# gerekiyorsa tam adres yazın, örn: https://benimsite.com
PANEL_CORS_ORIGIN=
